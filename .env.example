# Last.fm API key — get one at https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=

# Your Last.fm username (the one you scrobble to)
VITE_LASTFM_USERNAME=

# Shown as the page owner's name / in the footer
VITE_DISPLAY_NAME=Arion

# Optional profile links — leave blank to hide that link entirely
VITE_SPOTIFY_URL=https://open.spotify.com/user/yourname
VITE_AOTY_URL=https://www.albumoftheyear.org/user/yourname/

# How often to poll Last.fm, in milliseconds (default 15000 = 15s)
VITE_POLL_INTERVAL_MS=15000
